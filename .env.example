NORYX_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///noryx.sqlite
# Required in production; used for shared rate limits and RQ jobs
REDIS_URL=
PUBLIC_URL=http://127.0.0.1:8081
# SMTP is disabled unless configured. Never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Only when bound to loopback behind one trusted reverse proxy
TRUST_PROXY=0
